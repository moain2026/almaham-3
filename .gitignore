# ---- data that must NEVER be in this public repo (see docs/adr/0004) ----
/data/
*.npz
*.zip
# customer photos, anywhere
**/photos/
# third-party models are downloaded by scripts/download_models.sh (pinned SHA256)
*.onnx
*.tflite
!app/**/assets/models/*.onnx

# ---- secrets ----
.env
*.jks
*.keystore
key.properties
google-services.json
*adminsdk*.json

# ---- python ----
__pycache__/
*.py[cod]
.venv/
.ruff_cache/

# ---- flutter / android (for app/ later) ----
.dart_tool/
build/
.flutter-plugins*
.gradle/
local.properties
*.iml
.idea/
.DS_Store
# android build outputs / local sdk path
/app/local.properties
/app/.gradle/
/app/**/build/
/app/.kotlin/
dist/*.apk
.toolchain/
core
core.*
data/webdemo/
